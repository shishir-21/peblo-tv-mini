# -------------------------------------------------
# Peblo TV Mini Configuration
# -------------------------------------------------

# [Environment]
# Set to "production" to enforce security rules

# [Frontend Config]
VITE_CATALOGUE_URL=https://res.cloudinary.com/your_cloud_name_here/raw/upload/peblo-tv/catalogue.json
ENVIRONMENT=development

# [Database]
# The connection string to the PostgreSQL database.
DATABASE_URL=postgresql+psycopg://peblo:peblo_password@localhost:5433/peblo_tv

# [Security]
# The secret key for signing JWTs. Must be a long, random string in production.
# In development, a default safe key will be used if omitted.
SECRET_KEY=

# [CORS]
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# [Storage]
# Set to "local" for local file storage, or "cloudinary" for Cloudinary
STORAGE_BACKEND=local
STORAGE_PATH=backend/storage

# [Cloudinary]
# Required only if STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
