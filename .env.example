# -------------------------------------------------
# Peblo TV Mini Configuration
# -------------------------------------------------

# [Environment]
# Set to "production" to enforce security rules
ENVIRONMENT=development

# [Database]
# The connection string to the PostgreSQL database.
DATABASE_URL=postgresql+psycopg://peblo:peblo_password@localhost:5433/peblo_tv

# [Security]
# The secret key for signing JWTs. Must be a long, random string in production.
# In development, a default safe key will be used if omitted.
SECRET_KEY=

# [CORS]
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# [Storage]
# Set to "local" for local file storage, or "r2" for Cloudflare R2
STORAGE_BACKEND=local
STORAGE_PATH=backend/storage

# [Cloudflare R2]
# Required only if STORAGE_BACKEND=r2
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET_NAME=your_bucket_name_here
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<id>.r2.dev
